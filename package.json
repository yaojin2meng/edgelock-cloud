{
  "name": "edgelock-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "edgelock 云控服务（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 execute edgelock --remote --file=schema.sql",
    "migrate:local": "wrangler d1 execute edgelock --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260926.1"
  }
}
